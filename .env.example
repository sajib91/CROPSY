# ---------------------------------------------------------------------------
# CROPSY foundation environment template
# Copy to .env for local development. Never commit real secrets.
# All values below are safe local defaults.
# ---------------------------------------------------------------------------

# Shared (business API, web, mobile)
NODE_ENV=development
LOG_LEVEL=info

# Business API (Fastify)
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
SERVICE_NAME=cropsy-business-api

# PostgreSQL + PostGIS (Prisma)
# Use a database/user that can CREATE EXTENSION postgis on first migration.
DATABASE_URL=postgresql://cropsy:cropsy@localhost:5432/cropsy?schema=public&connection_limit=5

# Authentication (local development defaults only)
# Production requires all *_STORE switches below to be prisma, a strong secret, and AUTH_OTP_PROVIDER_MODE=http.
AUTH_STORE=memory
FARM_STORE=memory
AGRICULTURE_STORE=memory
CATALOG_STORE=memory
MARKETPLACE_STORE=memory
WAREHOUSE_STORE=memory
ORDERS_STORE=memory
PAYMENTS_STORE=memory
LEDGER_STORE=memory
# Payment providers are supplied by the deployment, never seeded or invented.
# Example shape (replace entirely in production; never commit real secrets):
# PAYMENT_PROVIDERS_JSON=[{"code":"PROVIDER_CODE","methods":["MOBILE_BANKING","CARD","BANK_TRANSFER","CASH"],"webhookSecret":"FROM_SECRET_MANAGER"}]
PAYMENT_PROVIDER_MODE=configured
PAYMENT_PROVIDERS_JSON=[]
# Structural ledger account overrides; commission rates and settlement periods are caller-supplied policy snapshots.
LEDGER_ACCOUNTS_JSON=
AUTH_JWT_SECRET=dev-only-cropsy-access-token-secret-change-me-for-production
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_PURPOSE_TOKEN_TTL_SECONDS=900
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCKOUT_MINUTES=15
AUTH_OTP_LENGTH=6
AUTH_OTP_TTL_SECONDS=300
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
AUTH_OTP_PROVIDER_MODE=preview
AUTH_SMS_PROVIDER_URL=
AUTH_SMS_PROVIDER_TOKEN=
AUTH_EMAIL_PROVIDER_URL=
AUTH_EMAIL_PROVIDER_TOKEN=
AUTH_OTP_PROVIDER_TIMEOUT_MS=5000
AUTH_COOKIE_SECURE=auto
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_ACCESS_NAME=cropsy_access
AUTH_COOKIE_REFRESH_NAME=cropsy_refresh
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
AUTH_SELF_REGISTERABLE_ROLE_CODES=FARMER,BUYER,WHOLESALER,RETAILER,AGRICULTURAL_INPUT_SUPPLIER,LOGISTICS_PROVIDER,WAREHOUSE_OPERATOR,AGRICULTURAL_EXPERT,QUALITY_INSPECTOR
AUTHZ_POLICY_JSON=

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Optional server-only override for the same-origin auth proxy. Useful when the
# browser-facing API URL differs from the backend URL reachable by Next.js.
CROPSY_API_PROXY_URL=
# Optional public canonical origin for SEO metadata in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional. The public site shows a contact link only when this is set.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# AI service (FastAPI)
CROPSY_AI_HOST=0.0.0.0
CROPSY_AI_PORT=4100
CROPSY_AI_SERVICE_NAME=cropsy-ai-service
CROPSY_AI_LOG_LEVEL=info
CROPSY_AI_ENVIRONMENT=development
CROPSY_AI_INTERNAL_SERVICE_ID=cropsy-business-api
CROPSY_AI_INTERNAL_SERVICE_SECRET=dev-only-ai-service-secret-change-me
CROPSY_AI_LLM_PROVIDER=mock
CROPSY_AI_EMBEDDING_PROVIDER=deterministic
CROPSY_AI_EMBEDDING_DIMENSIONS=256
CROPSY_AI_VECTOR_BACKEND=memory
CROPSY_AI_KEYWORD_BACKEND=memory
CROPSY_AI_RETRIEVAL_FUSION_METHOD=weighted
CROPSY_AI_RETRIEVAL_VECTOR_WEIGHT=0.65
CROPSY_AI_RETRIEVAL_KEYWORD_WEIGHT=0.35
CROPSY_AI_RETRIEVAL_ENABLE_QUERY_EXPANSION=true
CROPSY_AI_RERANKER_PROVIDER=lexical
CROPSY_AI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CROPSY_AI_RERANKER_BASE_URL=
# Agentic RAG: LangGraph workflow, seven agents, bounded tools, human approval.
CROPSY_AI_AGENTIC_RAG_ENABLED=true
CROPSY_AI_AGENTIC_MAX_AGENT_ATTEMPTS=2
CROPSY_AI_AGENTIC_MAX_TOOL_CALLS=12
CROPSY_AI_AGENTIC_MAX_CONTEXT_CHARS=12000
# GraphRAG: memory for local development, none for explicit unavailability, neo4j for production.
CROPSY_AI_GRAPH_BACKEND=memory
CROPSY_AI_GRAPH_EXTRACTION_PROVIDER=deterministic
CROPSY_AI_GRAPH_CONFIDENCE_THRESHOLD=0.6
CROPSY_AI_GRAPH_MAX_HOPS=2
CROPSY_AI_GRAPH_MAX_PATHS=20
CROPSY_AI_GRAPH_COMMUNITY_ALGORITHM=connected_components
CROPSY_AI_NEO4J_URI=
CROPSY_AI_NEO4J_USER=
CROPSY_AI_NEO4J_PASSWORD=
CROPSY_AI_NEO4J_DATABASE=neo4j
CROPSY_AI_CONVERSATION_STORE=memory
# Market forecasting uses deterministic local models only; no live quote is claimed.
CROPSY_AI_FORECASTING_MODEL=moving_average
CROPSY_AI_FORECASTING_DEFAULT_HORIZON=3
CROPSY_AI_FORECASTING_MIN_OBSERVATIONS=4
CROPSY_AI_FORECASTING_VALIDATION_SIZE=2
# Weather: none is explicit unavailability. There is no mock weather provider.
CROPSY_AI_WEATHER_PROVIDER=none
CROPSY_AI_WEATHER_BASE_URL=
CROPSY_AI_WEATHER_API_KEY=
CROPSY_AI_WEATHER_API_KEY_HEADER=x-api-key
CROPSY_AI_WEATHER_TIMEOUT_SECONDS=10
CROPSY_AI_WEATHER_OBSERVATION_PATH=/observations
CROPSY_AI_WEATHER_FORECAST_PATH=/forecasts
CROPSY_AI_WEATHER_ALERTS_PATH=/alerts
CROPSY_AI_WEATHER_SOURCE_NAME=
# Advisory thresholds are deployment configuration, not verified crop requirements.
CROPSY_AI_WEATHER_HEAVY_RAIN_MM=50
CROPSY_AI_WEATHER_LOW_RAIN_MM=1
CROPSY_AI_WEATHER_HIGH_TEMPERATURE_C=38
CROPSY_AI_WEATHER_LOW_TEMPERATURE_C=5
CROPSY_AI_WEATHER_HIGH_HUMIDITY_PCT=90
CROPSY_AI_OCR_MODE=auto
# Multimodal RAG: PDFs, images, charts, tables, text, and research materials.
# Image signatures are deterministic (not semantic embeddings). Vision is advisory only.
CROPSY_AI_MULTIMODAL_ENABLED=true
CROPSY_AI_VISION_PROVIDER=none
CROPSY_AI_VISION_BASE_URL=
CROPSY_AI_VISION_MODEL=
CROPSY_AI_VISION_API_KEY=
CROPSY_AI_VISION_TIMEOUT_SECONDS=20
CROPSY_AI_VISION_MAX_CHARS=2000
# Unified orchestration: rule-based routing, fusion, fallbacks, and monitoring.
CROPSY_AI_ORCHESTRATION_ENABLED=true
CROPSY_AI_ORCHESTRATION_MAX_EVIDENCE=12
CROPSY_AI_ORCHESTRATION_CONTEXT_CHARS=12000
# Advisory image analysis: "none" means no model and no prediction. The HTTP
# adapter never turns observations into a confirmed diagnosis or prescription.
CROPSY_AI_IMAGE_ANALYSIS_ENABLED=true
CROPSY_AI_IMAGE_ANALYSIS_MODEL_PROVIDER=none
CROPSY_AI_IMAGE_ANALYSIS_MODEL=
CROPSY_AI_IMAGE_ANALYSIS_BASE_URL=
CROPSY_AI_IMAGE_ANALYSIS_API_KEY=
CROPSY_AI_IMAGE_ANALYSIS_TIMEOUT_SECONDS=20
CROPSY_AI_IMAGE_ANALYSIS_MIN_WIDTH=64
CROPSY_AI_IMAGE_ANALYSIS_MIN_HEIGHT=64
CROPSY_AI_IMAGE_ANALYSIS_MAX_REFERENCES=5
CROPSY_AI_IMAGE_ANALYSIS_MAX_RECORDS=500
# Evaluation framework: scores exist only for completed real runs; no seeds or estimates.
CROPSY_AI_EVALUATION_FRAMEWORK_ENABLED=true
CROPSY_AI_EVALUATION_FRAMEWORK_MAX_RUNS=100
CROPSY_AI_EVALUATION_FRAMEWORK_MAX_FEEDBACK=1000
CROPSY_AI_ORCHESTRATION_FALLBACK_ENABLED=true
# Production requires Qdrant + OpenSearch + HTTP BGE and Neo4j when agentic RAG is enabled,
# unless mock providers are explicitly allowed. LLM graph extraction requires an HTTP LLM.
CROPSY_AI_ALLOW_MOCK_PROVIDER=false

# Business API -> AI service gateway (server-side only; never use from frontend apps)
AI_SERVICE_URL=http://127.0.0.1:4100
AI_SERVICE_ID=cropsy-business-api
AI_SERVICE_SECRET=dev-only-ai-service-secret-change-me
AI_SERVICE_TIMEOUT_MS=10000

# Notifications (owned by the business API)
# Dev/test use the in-memory queue. Production requires NOTIFICATION_QUEUE_DRIVER=bullmq
# and a Redis URL. Delivery eligibility, preferences, retries, and logs stay server-side.
NOTIFICATION_QUEUE_DRIVER=memory
NOTIFICATION_REDIS_URL=redis://127.0.0.1:6379
NOTIFICATION_REALTIME_ENABLED=true
NOTIFICATION_PROVIDER_MODE=log

# Provider credentials are used only by the API; never ship them in mobile/web bundles.
# Set the matching mode when enabling a real provider, e.g. NOTIFICATION_PROVIDER_MODE=smtp.
NOTIFICATION_SMTP_URL=smtp://127.0.0.1:1025
NOTIFICATION_EMAIL_FROM=CROPSY <no-reply@cropsy.local>
NOTIFICATION_SMS_PROVIDER=log
NOTIFICATION_SMS_ACCOUNT_SID=
NOTIFICATION_SMS_AUTH_TOKEN=
NOTIFICATION_SMS_FROM=
NOTIFICATION_EXPO_ACCESS_TOKEN=
NOTIFICATION_FCM_PROJECT_ID=
NOTIFICATION_FCM_CLIENT_EMAIL=
NOTIFICATION_FCM_PRIVATE_KEY=

# Expo public configuration for mobile builds (safe to embed in the app bundle)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
EXPO_PUBLIC_REALTIME_ENABLED=true
EXPO_PUBLIC_PUSH_ENABLED=true
EXPO_PUBLIC_DEFAULT_LANGUAGE=en
EXPO_PUBLIC_CACHE_TTL_MS=600000
