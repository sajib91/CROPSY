# ---------------------------------------------------------------------------
# CROPSY foundation environment template
# Copy to .env for local development. Never commit real secrets.
# All values below are safe local defaults.
# ---------------------------------------------------------------------------

# Shared (business API, web, mobile)
NODE_ENV=development
LOG_LEVEL=info

# Business API (Fastify)
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000
SERVICE_NAME=cropsy-business-api

# PostgreSQL + PostGIS (Prisma)
# Use a database/user that can CREATE EXTENSION postgis on first migration.
DATABASE_URL=postgresql://cropsy:cropsy@localhost:5432/cropsy?schema=public&connection_limit=5

# Web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Mobile (Expo)
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# AI service (FastAPI / LangGraph-ready)
CROPSY_AI_HOST=0.0.0.0
CROPSY_AI_PORT=4100
CROPSY_AI_SERVICE_NAME=cropsy-ai-service
CROPSY_AI_LOG_LEVEL=info
