{
  "expo": {
    "name": "CROPSY",
    "slug": "cropsy",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "cropsy",
    "platforms": ["ios", "android", "web"],
    "newArchEnabled": false,
    "android": {
      "package": "com.cropsy.app",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.cropsy.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "CROPSY uses the camera to analyze crops and attach proof of delivery.",
        "NSPhotoLibraryUsageDescription": "CROPSY uses your photos to attach crop images and documents to listings.",
        "UIBackgroundModes": ["remote-notification"]
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-image-picker", "expo-document-picker", "expo-notifications"]
  }
}
