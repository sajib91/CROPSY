  @@unique([user_id, role_code, scope_key])
  @@index([organization_id])
  @@map("role_profile_extensions")
}

model UserAddress {
  id             String                                @id @default(uuid()) @db.Uuid
  user_id        String                                @db.Uuid
  label          String                                @db.VarChar(80)
