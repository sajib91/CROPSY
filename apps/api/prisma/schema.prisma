  @@index([user_id, enabled])
  @@map("notification_preferences")
}

model RoleProfileExtension {
  id              String   @id @default(uuid()) @db.Uuid
  user_id         String   @db.Uuid
  role_code       String   @db.VarChar(80)
  organization_id String?  @db.Uuid
