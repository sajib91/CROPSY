# CROPSY AI service environment template. Copy values into the root .env.
# All values below are safe local defaults. Never commit real credentials.

CROPSY_AI_HOST=0.0.0.0
CROPSY_AI_PORT=4100
CROPSY_AI_SERVICE_NAME=cropsy-ai-service
CROPSY_AI_LOG_LEVEL=info
CROPSY_AI_ENVIRONMENT=development
CROPSY_AI_API_PREFIX=/api/v1

# Internal service-to-service HMAC authentication (shared with the business API).
CROPSY_AI_INTERNAL_SERVICE_ID=cropsy-business-api
CROPSY_AI_INTERNAL_SERVICE_SECRET=dev-only-ai-service-secret-change-me
CROPSY_AI_INTERNAL_SIGNATURE_TOLERANCE_SECONDS=300

# Providers. Credentials stay server-side and are never serialized to clients.
CROPSY_AI_LLM_PROVIDER=mock
CROPSY_AI_LLM_BASE_URL=
CROPSY_AI_LLM_API_KEY=
CROPSY_AI_EMBEDDING_PROVIDER=deterministic
CROPSY_AI_EMBEDDING_BASE_URL=
CROPSY_AI_EMBEDDING_API_KEY=
CROPSY_AI_EMBEDDING_DIMENSIONS=256
# Optional JSON array overriding model configuration, e.g. [{"key":"advisory-http",...}]
CROPSY_AI_MODEL_CONFIGS_JSON=
CROPSY_AI_ALLOW_MOCK_PROVIDER=true

# Retrieval backends. Optional dependencies are imported lazily.
CROPSY_AI_VECTOR_BACKEND=memory
CROPSY_AI_QDRANT_URL=
CROPSY_AI_QDRANT_API_KEY=
CROPSY_AI_QDRANT_COLLECTION=cropsy_agricultural_chunks
CROPSY_AI_KEYWORD_BACKEND=memory
CROPSY_AI_OPENSEARCH_URL=
CROPSY_AI_OPENSEARCH_INDEX=cropsy_agricultural_chunks
CROPSY_AI_OPENSEARCH_USERNAME=
CROPSY_AI_OPENSEARCH_PASSWORD=
CROPSY_AI_RETRIEVAL_BACKEND_TIMEOUT_SECONDS=10

# Hybrid retrieval tuning. vectorWeight + keywordWeight must equal 1.0.
CROPSY_AI_RETRIEVAL_FUSION_METHOD=weighted
CROPSY_AI_RETRIEVAL_FETCH_K=50
CROPSY_AI_RETRIEVAL_VECTOR_WEIGHT=0.65
CROPSY_AI_RETRIEVAL_KEYWORD_WEIGHT=0.35
CROPSY_AI_RETRIEVAL_RRF_K=60
CROPSY_AI_RETRIEVAL_DEDUPLICATION_THRESHOLD=0.92
CROPSY_AI_RETRIEVAL_MAX_CHUNKS_PER_DOCUMENT=3
CROPSY_AI_RETRIEVAL_MIN_SCORE=0
CROPSY_AI_RETRIEVAL_ENABLE_QUERY_EXPANSION=true
CROPSY_AI_RETRIEVAL_MAX_QUERY_VARIANTS=3
CROPSY_AI_RETRIEVAL_DEFAULT_JURISDICTION=Bangladesh

# Reranking. Production requires the HTTP BGE adapter; lexical is dev/test only.
CROPSY_AI_RERANKER_PROVIDER=lexical
CROPSY_AI_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
CROPSY_AI_RERANKER_BASE_URL=
CROPSY_AI_RERANKER_API_KEY=
CROPSY_AI_RERANKER_TIMEOUT_SECONDS=20
CROPSY_AI_RERANKER_BATCH_SIZE=16

# Conversational assistant history (bounded process-local adapter by default).
CROPSY_AI_CONVERSATION_STORE=memory
CROPSY_AI_CONVERSATION_MAX_HISTORY_TURNS=8
CROPSY_AI_CONVERSATION_MAX_MESSAGES=100
CROPSY_AI_CONVERSATION_TTL_SECONDS=86400

# Market forecasting. Deterministic local pipelines; no live quote is invented.
CROPSY_AI_FORECASTING_MODEL=moving_average
CROPSY_AI_FORECASTING_DEFAULT_HORIZON=3
CROPSY_AI_FORECASTING_MIN_OBSERVATIONS=4
CROPSY_AI_FORECASTING_VALIDATION_SIZE=2

# Weather provider. "none" means explicitly unavailable; there is no mock adapter.
CROPSY_AI_WEATHER_PROVIDER=none
CROPSY_AI_WEATHER_BASE_URL=
CROPSY_AI_WEATHER_API_KEY=
CROPSY_AI_WEATHER_API_KEY_HEADER=x-api-key
CROPSY_AI_WEATHER_TIMEOUT_SECONDS=10
CROPSY_AI_WEATHER_OBSERVATION_PATH=/observations
CROPSY_AI_WEATHER_FORECAST_PATH=/forecasts
CROPSY_AI_WEATHER_ALERTS_PATH=/alerts
CROPSY_AI_WEATHER_SOURCE_NAME=
# Advisory thresholds are deployment configuration, not verified crop requirements.
CROPSY_AI_WEATHER_HEAVY_RAIN_MM=50
CROPSY_AI_WEATHER_LOW_RAIN_MM=1
CROPSY_AI_WEATHER_HIGH_TEMPERATURE_C=38
CROPSY_AI_WEATHER_LOW_TEMPERATURE_C=5
CROPSY_AI_WEATHER_HIGH_HUMIDITY_PCT=90

# Document processing.
CROPSY_AI_OCR_MODE=auto
CROPSY_AI_MAX_UPLOAD_BYTES=10485760
CROPSY_AI_MAX_CHUNK_CHARS=1200
CROPSY_AI_CHUNK_OVERLAP_CHARS=150

# Protection and observability.
CROPSY_AI_RATE_LIMIT_MAX_REQUESTS=120
CROPSY_AI_RATE_LIMIT_WINDOW_SECONDS=60
CROPSY_AI_MAX_TRACE_HISTORY=500
CROPSY_AI_RETRY_MAX_ATTEMPTS=3
CROPSY_AI_RETRY_BASE_DELAY_SECONDS=0.1
CROPSY_AI_RETRY_MAX_DELAY_SECONDS=2
