{
  "datasetId": "eval-multimodal-retrieval-v1",
  "version": "1.0.0",
  "suite": "multimodal_retrieval",
  "cases": [
    {
      "caseId": "mm-001",
      "category": "multimodal_retrieval",
      "input": {
