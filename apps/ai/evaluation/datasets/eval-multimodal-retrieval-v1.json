        "minRecallAtK": 0.9
      },
      "notes": "Ranking judgment for deterministic visual signatures."
    },
    {
      "caseId": "mm-002",
      "category": "multimodal_retrieval",
      "input": {
        "query": "Find the verified rice irrigation note.",
        "language": "en",
        "topK": 3
      },
      "expected": {
        "relevantAssetIds": ["eval-unified-doc"],
        "minRecallAtK": 0.5
      },
      "notes": "Cross-modal text-to-asset judgment."
